#!/usr/bin/env sh
# bin/hellmacs -- Hellmacs command-line tool. Run `bin/hellmacs help'.
#
# Runs Emacs in batch mode against this checkout; the commands live in
# core/hellmacs-cli.el. Set $EMACS to use a different Emacs binary;
# $HELLMACSDIR and the XDG_*_HOME variables are honored exactly as in
# an interactive session.

set -e

HELLMACS_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
EMACS=${EMACS:-emacs}

hellmacs() {
  "$EMACS" --batch \
    -l "$HELLMACS_ROOT/early-init.el" \
    --eval "(progn (add-to-list 'load-path hellmacs-core-dir) (require 'hellmacs-cli))" \
    -f hellmacs-cli-main -- "$@"
}

case "$1" in
  upgrade)
    shift
    case " $* " in
      *" --packages "*) ;;
      # Update Hellmacs first, then update packages in a fresh Emacs, so
      # that step runs the new code.
      *) hellmacs upgrade-self ;;
    esac
    hellmacs upgrade "$@"
    ;;
  *)
    hellmacs "$@"
    ;;
esac
